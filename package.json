{
  "name": "mouchotto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "data:export": "node scripts/main.js --export-static",
    "data:lines": "node scripts/main.js --export-lines",
    "data:prebuilt": "node scripts/export-prebuilt-stations.ts",
    "data:import:kyoto-bus": "node scripts/import-kyoto-city-bus.mjs",
    "data:import:kyoto-bus-timetables": "node scripts/import-kyoto-city-bus-timetables.mjs",
    "data:import:eizan-last-two": "node scripts/import-eizan-last-two.mjs",
    "test": "node --import ./tests/setup/register.mjs --test 'tests/unit/**/*.test.ts' 'tests/integration/**/*.test.ts'",
    "start": "next start",
    "test:parse": "node tests/e2e/live-parse.mjs",
    "test:unit": "node --import ./tests/setup/register.mjs --test 'tests/unit/**/*.test.ts'",
    "test:integration": "node --import ./tests/setup/register.mjs --test 'tests/integration/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "node --import ./tests/setup/register.mjs --test --experimental-test-coverage --test-coverage-include='lib/**' --test-coverage-include='data/**' --test-coverage-include='app/api/**' 'tests/unit/**/*.test.ts' 'tests/integration/**/*.test.ts'",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "cheerio": "latest",
    "dotenv": "latest",
    "next": "latest",
    "openai": "^7.8.0",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "7.0.2"
  }
}
